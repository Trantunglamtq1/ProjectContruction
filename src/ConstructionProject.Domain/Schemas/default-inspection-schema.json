{
  "display": "form",
  "components": [
    {
      "label": "Tên hạng mục kiểm tra",
      "key": "inspectionTitle",
      "type": "textfield",
      "input": true,
      "validate": {
        "required": true
      }
    },
    {
      "label": "Ngày kiểm tra",
      "key": "inspectionDate",
      "type": "datetime",
      "format": "yyyy-MM-dd hh:mm a",
      "enableDate": true,
      "enableTime": true,
      "input": true,
      "validate": {
        "required": true
      }
    },
    {
      "label": "Kết quả đánh giá",
      "key": "result",
      "type": "select",
      "data": {
        "values": [
          { "label": "Đạt yêu cầu (Pass)", "value": "pass" },
          { "label": "Không đạt yêu cầu (Fail)", "value": "fail" },
          { "label": "Chờ khắc phục (Pending Fix)", "value": "pending_fix" }
        ]
      },
      "input": true,
      "validate": {
        "required": true
      }
    },
    {
      "label": "Chi tiết kiểm tra & Sai số kỹ thuật",
      "key": "technicalDetails",
      "type": "textarea",
      "rows": 3,
      "input": true
    },
    {
      "label": "Ghi chú & Khuyến nghị",
      "key": "notes",
      "type": "textarea",
      "rows": 2,
      "input": true
    }
  ]
}
