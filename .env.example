# Cấu hình gửi Email qua Gmail SMTP (Miễn phí)
# 1. Truy cập https://myaccount.google.com/apppasswords
# 2. Tạo một "Mật khẩu ứng dụng" (App Password) gồm 16 ký tự (ví dụ: abcd efgh ijkl mnop)
# 3. Điền email và mật khẩu ứng dụng vào 2 dòng bên dưới (xóa khoảng trắng trong mật khẩu nếu có):

EMAIL_SENDER=
EMAIL_PASSWORD=

# Cấu hình mặc định SMTP của Gmail
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SENDER_NAME=ConstructInspect System
